# Generate working local credentials with npm run env:init.
POSTGRES_PASSWORD=
SESSION_SECRET=
DASHBOARD_ACCOUNTS='{"operator":{"token":"replace-with-a-random-operator-token","operator":true}}'
WORKER_TOKEN_LOCAL_1=
WORKER_TOKEN_LOCAL_2=
POLICY=qos
LOCAL_WORKER_CPUS=1

# Set COOKIE_SECURE=true when accessing the dashboard over HTTPS.
# AWS is enabled by explicitly configuring the instance and bucket.
# AWS_REGION=ap-south-1
# AWS_S3_BUCKET=
# EC2_INSTANCE_ID=
# EC2_ACCOUNT_ID=
# EC2_IDENTITY_CERT=/run/aws-iid.pem
# AWS_IID_CERT_FILE=
# AWS_WEB_ENV_FILE=.env.aws-web
# AWS_CONTROLLER_ENV_FILE=.env.aws-controller
# EC2_IMAGE_DIGEST=sha256:
# WORKER_TOKEN_EC2_1=
# WORKER_IMAGE_REF=registry.example/team/qos-worker@sha256:
# EC2_RATE_USD_HOUR=
# EC2_RATE_SOURCE=
# EC2_RATE_DATE=
